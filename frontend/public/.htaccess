# Kalam Compiler — settings for Apache / LiteSpeed web hosting (e.g. Hostinger "Web hosting").
# Docker/nginx deployments don't use this file (frontend/nginx.conf does the same job).

Options -Indexes
DirectoryIndex index.html

# File types Python (WebAssembly) and the app need
AddType application/wasm .wasm
AddType application/javascript .mjs
AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  # Required so Python can pause for input(): makes the page "cross-origin isolated".
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "require-corp"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # connect-src allows https/wss so the backend may live on another domain (see kalam-config.json)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https: wss:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

  # Caching: hashed build files forever, Python runtime 30 days, app shell always fresh
  SetEnvIf Request_URI "^/assets/" KALAM_IMMUTABLE
  SetEnvIf Request_URI "^/pyodide/" KALAM_PYODIDE
  Header set Cache-Control "public, max-age=31536000, immutable" env=KALAM_IMMUTABLE
  Header set Cache-Control "public, max-age=2592000" env=KALAM_PYODIDE
  <FilesMatch "^(index\.html|sw\.js|kalam-config\.json|precache-manifest\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/wasm image/svg+xml application/manifest+json
</IfModule>
