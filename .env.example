# Copy to .env and change every value marked CHANGE-ME. Never commit .env.

# --- required ---
KALAM_SECRET_KEY=CHANGE-ME-run: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=CHANGE-ME-long-random-password

# First admin account (created on first start if no admin exists)
KALAM_ADMIN_EMAIL=admin@your-school.example
KALAM_ADMIN_PASSWORD=CHANGE-ME-admin-password

# Teachers can sign up themselves with this code. Leave empty to turn sign-up off.
KALAM_TEACHER_INVITE_CODE=CHANGE-ME-share-with-teachers

# --- optional ---
KALAM_HTTP_PORT=80
KALAM_SHARE_ENABLED=true

# "Explain my code" AI helper — OFF by default. Only the code is sent, never names.
#   anthropic          -> Claude (needs KALAM_AI_API_KEY)
#   openai_compatible  -> a self-hosted model server, e.g. Ollama: KALAM_AI_BASE_URL=http://ollama:11434
KALAM_AI_PROVIDER=none
KALAM_AI_MODEL=claude-opus-5-5
KALAM_AI_API_KEY=
KALAM_AI_BASE_URL=

# Piston compiler versions ("*" = newest installed)
KALAM_PISTON_C_VERSION=*
KALAM_PISTON_CPP_VERSION=*
